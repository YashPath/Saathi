# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://saathi:saathi@localhost:5432/saathi

# --- LLM ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-google-ai-studio-key

# --- Mobile app ---
APP_LOGIN_DAYS=30

# --- Seed users (digits only, with country code, e.g. 919876543210) ---
SEED_SHOPKEEPER_PHONE=91XXXXXXXXXX
SEED_SHOPKEEPER_NAME=Yash Store
SEED_PROFESSOR_PHONE=91XXXXXXXXXX
SEED_PROFESSOR_NAME=Prof Demo
SEED_PIN=123456

# --- Agent behaviour ---
HISTORY_LIMIT=10
APPROVAL_THRESHOLD=5000
APPROVAL_TTL_MINUTES=10
BILLS_DIR=bills

# --- Scheduler (evening summary, IST) ---
SCHEDULER_ENABLED=true
SUMMARY_HOUR=21
ASSIGNMENT_REMINDER_HOUR=18
CHROMA_DIR=chroma
EMBEDDING_MODEL=models/gemini-embedding-001

# --- Dashboard (leave the secret empty to turn it off) ---
DASHBOARD_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app
DASHBOARD_LINK_HOURS=24
